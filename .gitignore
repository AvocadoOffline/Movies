back/__pycache__/
back/*/__pycache__/
back/*.pyc
back/*.pyo
back/*.pyd

# Virtual Environment (the movie-backend folder)
back/movie-backend/
back/venv/
back/.venv/
back/env/

# Environment variables
back/.env
back/.env.local

# Database
back/*.db
back/*.sqlite
back/*.sqlite3

# Testing
back/.pytest_cache/
back/.coverage
back/htmlcov/

